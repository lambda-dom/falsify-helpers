cabal-version:      3.0
name:               falsify-helpers
version:            0.1.0.0
synopsis:           Helpers for testing with the falsify package.
description:        Please see the README on GitHub at <https://github.com/lambda-dom/falsify-helpers#readme>
category:           Data, Testing
homepage:           https://github.com/lambda-dom/falsify-helpers#readme
author:             lambda-dom
license:            BSD-3-Clause
license-file:       LICENSE
maintainer:         grodrigues.math@gmail.com
copyright:          2026 G. Rodrigues
build-type:         Simple
tested-with:
    GHC == {9.10.3}
extra-doc-files:
    LICENSE
    README.md
    CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/lambda-dom/falsify-helpers

common common-fields
    default-language: GHC2021
    default-extensions:
        DerivingStrategies
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wmissing-deriving-strategies
        -Wunused-packages
        -- Prepare for dependent types.
        -Wterm-variable-capture
    build-depends:
        base >=4.20 && <4.21,
        text >=2.1  && <2.2,

library
    import:
        common-fields
    hs-source-dirs:
        src
    exposed-modules:
        Data.Either
